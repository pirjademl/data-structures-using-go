package implementations

type Node struct {
	Next     *Node
	Prev     *Node
	Key, Val int
}

func NewNode(key, val int) *Node {
	return &Node{
		Next: nil,
		Prev: nil,
		Key:  key,
		Val:  val,
	}
}
func (head *Node) AddNode(newNode *Node) {
	// you have to insert this node after head node
	temp := head.Next
	newNode.Next = temp
	newNode.Prev = head
	temp.Prev = newNode
	head.Next = newNode
}
func (head *Node) DeleteNode(node *Node) {
	tempPrev := node.Prev
	tempNext := node.NextA
	tempPrev.Next = tempNext

}

type LRUCache struct {
	Capacity int
	HashMap  map[int]*Node
	List     *Node
}

func NewLruCacheWithCapacity(capacity int) *LRUCache {
	head := NewNode(-1, -1)
	tail := NewNode(-1, -1)
	head.Next = tail
	tail.Prev = head
	return &LRUCache{
		Capacity: capacity,
		HashMap:  make(map[int]*Node),
		List:     head,
	}
}
